<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    app:cardBackgroundColor="#130822"
    app:strokeColor="#A066FF"
    app:strokeWidth="1dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ HEADER: Ícone + Título + Botão fechar ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- Ícone ESP32 com fundo arredondado roxo claro -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_modal_icon_box"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_esp32"
                    app:tint="#A066FF"/>
            </FrameLayout>

            <!-- Título em 2 linhas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURAR"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/orbitron"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP32"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/orbitron"/>
            </LinearLayout>

            <!-- Botão fechar (X) -->
            <FrameLayout
                android:id="@+id/btnFecharModalEsp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_modal_close_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="#A066FF"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Divisor horizontal -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E1A47"/>

        <!-- ============ SECTION 1: DISPOSITIVOS SALVOS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Header da seção com linha decorativa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPOSITIVOS SALVOS"
                    android:textColor="#A066FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:fontFamily="@font/orbitron"
                    android:layout_marginEnd="10dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2E1A47"/>
            </LinearLayout>

            <!-- ============ DROPDOWN CUSTOMIZADO ============ -->
            <LinearLayout
                android:id="@+id/dropdownContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Botão principal do dropdown (mostra o MAC selecionado) -->
                <LinearLayout
                    android:id="@+id/dropdownHeader"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_dropdown_header"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATIVO"
                        android:textColor="#A09DA5"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/dropdownSelectedMac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="C0:49:EF:65:16:FE"
                        android:textColor="#00FF66"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sourcecodepro_bold"/>
                </LinearLayout>

                <!-- Botão da seta (toggle do dropdown) -->
                <FrameLayout
                    android:id="@+id/dropdownToggle"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dropdown_toggle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/dropdownArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_arrow_down"
                        app:tint="#A066FF"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ============ LISTA EXPANDIDA (inicialmente oculta) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dropdownListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="#0A0410"
                app:strokeColor="#2E1A47"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="220dp"
                    android:scrollbars="vertical"
                    android:scrollbarThumbVertical="@drawable/bg_scrollbar_thumb"
                    android:scrollbarSize="4dp">

                    <LinearLayout
                        android:id="@+id/dropdownListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"/>
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ============ SECTION 2: ADICIONAR NOVO ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp">

            <!-- Header da seção com linha decorativa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADICIONAR NOVO"
                    android:textColor="#A066FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:fontFamily="@font/orbitron"
                    android:layout_marginEnd="10dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2E1A47"/>
            </LinearLayout>

            <!-- Campo: Endereço MAC + botão Adicionar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endereço MAC"
                android:textColor="#CFC9D8"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#0A0410"
                    app:strokeColor="#2E1A47"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/editNovoMac"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:paddingHorizontal="12dp"
                        android:hint="XX:XX:XX:XX:XX:XX"
                        android:textColorHint="#5A5266"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/sourcecodepro_bold"
                        android:inputType="textCapCharacters"
                        android:maxLength="17"
                        android:digits="0123456789ABCDEFabcdef:"
                        android:imeOptions="actionDone"
                        android:gravity="center_vertical"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botão + ADICIONAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarEsp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="14dp"
                    android:text="ADICIONAR"
                    android:textColor="#00FF66"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/orbitron"
                    app:icon="@drawable/ic_plus"
                    app:iconSize="14dp"
                    app:iconTint="#00FF66"
                    app:iconPadding="6dp"
                    app:strokeColor="#00FF66"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#00210E"
                    app:cornerRadius="10dp"
                    app:rippleColor="#00FF66"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ BOTÃO CONFIRMAR SELEÇÃO ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarSelecao"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="16dp"
            android:text="CONFIRMAR SELEÇÃO"
            android:textColor="#A066FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="@font/orbitron"
            app:icon="@drawable/ic_check_download"
            app:iconSize="18dp"
            app:iconTint="#A066FF"
            app:iconPadding="10dp"
            app:strokeColor="#A066FF"
            app:strokeWidth="1dp"
            app:backgroundTint="#1A0D2A"
            app:cornerRadius="14dp"
            app:rippleColor="#A066FF"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>