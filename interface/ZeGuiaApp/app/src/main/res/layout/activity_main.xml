<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0410"
    android:fitsSystemWindows="true">

    <!-- ============================== HEADER ============================== -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="#130822"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/headerBottomLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#2E1A47"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground" />

    <ImageView
        android:id="@+id/btnLogo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/gear_logo"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_logo_gradient"
        android:clickable="true"
        android:focusable="true"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/titleApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZÉ-GUIA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.12"
        android:fontFamily="@font/orbitron"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toEndOf="@id/btnLogo" />

    <!-- Badge ESP32 -->
    <LinearLayout
        android:id="@+id/cardConfigEsp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_esp32_badge"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toStartOf="@id/cardBluetoothToggle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ic_esp32"
            app:tint="#A066FF"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_dot_green"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/txtEspStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP32 ATIVO"
                    android:textColor="#00FF66"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/orbitron"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtEspMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C0:49:EF:65:16:FE"
                android:textColor="#CFC9D8"
                android:textSize="8sp"
                android:fontFamily="@font/sourcecodepro_bold"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnConfigMac"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Bluetooth: ícone + bolinha indicadora + SWITCH visível ao lado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBluetoothToggle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="#1A0D2A"
        app:cardCornerRadius="10dp"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/iconBluetooth"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:srcCompat="@drawable/ic_bluetooth"
                app:tint="#A066FF" />


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:scaleX="0.75"
                android:scaleY="0.75"
                app:thumbTint="#A066FF"
                app:trackTint="#2E1A47"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================== CARD QUADRO GERAL ============================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainStatusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#130822"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBottomLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Título + botão EXPORTAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUADRO GERAL"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/orbitron"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportar"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="EXPORTAR"
                    android:textSize="8sp"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/orbitron"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_btn_export_gradient"
                    app:icon="@drawable/ic_export"
                    app:iconSize="12dp"
                    app:iconTint="#FFFFFF"
                    app:iconPadding="4dp"
                    app:cornerRadius="10dp"
                    app:rippleColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E1A47"
                android:layout_marginVertical="6dp"/>

            <!-- ============ Linha: CRONÔMETRO (esquerda) | PARÂMETROS + INFORMAÇÕES (direita) ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- ============ CRONÔMETRO (cresce verticalmente até a altura da coluna direita) ============ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_inner_panel"
                    android:padding="8dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRONÔMETRO"
                        android:textColor="#A09DA5"
                        android:textSize="8sp"
                        android:letterSpacing="0.08"
                        android:fontFamily="@font/orbitron"/>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        app:srcCompat="@drawable/ic_clock"
                        app:tint="#A066FF"/>

                    <!-- Cronômetro: largura fixa e gravity=center pra não pular horizontalmente -->
                    <TextView
                        android:id="@+id/txtCronometro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|bottom"
                        android:text="0.00"
                        android:textColor="#00FF66"
                        android:textSize="26sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:shadowColor="#9900FF66"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:minEms="5"
                        android:paddingTop="8dp"/>
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent"/>

                <!-- ============ COLUNA DIREITA ============ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:orientation="vertical">

                    <!-- PARÂMETROS (com ícone do lápis controlado dinamicamente) -->
                    <LinearLayout
                        android:id="@+id/btnAbrirEdicao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_inner_panel"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="PARÂMETROS"
                                android:textColor="#A09DA5"
                                android:textSize="8sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="@font/orbitron"/>

                            <ImageView
                                android:id="@+id/iconEditarParams"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                app:srcCompat="@drawable/ic_edit_pencil"
                                app:tint="#5A4470"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Kp" android:textColor="#CFC9D8" android:textSize="9sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Ki" android:textColor="#CFC9D8" android:textSize="9sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Kd" android:textColor="#CFC9D8" android:textSize="9sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="VM" android:textColor="#CFC9D8" android:textSize="9sp" android:fontFamily="@font/sourcecodepro_bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <TextView android:id="@+id/txtParamKp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0.0" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtParamKi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0.0" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtParamKd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0.0" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtParamVR" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="5dp"/>

                    <!-- INFORMAÇÕES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_inner_panel"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="INFORMAÇÕES"
                            android:textColor="#A09DA5"
                            android:textSize="8sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="@font/orbitron"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estado" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtEstadoRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Modo" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtModoRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estratégia" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                            <TextView android:id="@+id/txtEstrategiaRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BATERIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_inner_panel"
                android:padding="7dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATERIA"
                    android:textColor="#A09DA5"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/orbitron"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/txtBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:id="@+id/layoutBarrasBateria"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_battery_track"
                        android:padding="2dp"
                        android:weightSum="6">

                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_battery_segment_on"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        app:srcCompat="@drawable/ic_battery"
                        app:tint="#A066FF"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================== LABEL CONTROLES ============================== -->
    <TextView
        android:id="@+id/labelControles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTROLES"
        android:textColor="#A09DA5"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:fontFamily="@font/orbitron"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/mainStatusCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ============================== CONTROLES ============================== -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/labelControles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CALIBRAR + SENSORES (botões maiores: 52dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="CALIBRAR"
                android:textColor="#F39200"
                android:letterSpacing="0.1"
                app:icon="@drawable/ic_calibrar"
                app:iconTint="#F39200"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:strokeColor="#F39200"
                app:strokeWidth="1dp"
                app:backgroundTint="#1A0F00"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#F39200"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLerSensores"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="SENSORES"
                android:textColor="#FFEB3B"
                android:letterSpacing="0.1"
                app:icon="@drawable/ic_sensor"
                app:iconTint="#FFEB3B"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:strokeColor="#FFEB3B"
                app:strokeWidth="1dp"
                app:backgroundTint="#1A1900"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#FFEB3B"/>
        </LinearLayout>

        <!-- Card MODO + ESTRATÉGIA (botões internos: 46dp) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#0D0614"
            app:strokeColor="#2E1A47"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/modo"
                        app:tint="#00E5FF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODO"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/follower"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="SEGUIDOR"
                        android:textColor="#00BFFF"
                        android:letterSpacing="0.1"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="10dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chase"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="PERSEGUIDOR"
                        android:textColor="#00BFFF"
                        android:letterSpacing="0.1"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="10dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/ic_estrategia"
                        app:tint="#E020FF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTRATÉGIA"
                        android:textColor="#E020FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/conservative"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="CONSERVADOR"
                        android:textColor="#C040FF"
                        android:letterSpacing="0.1"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="10dp"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/risk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="ARRISCADO"
                        android:textColor="#C040FF"
                        android:letterSpacing="0.1"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="10dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- COMEÇAR + FINALIZAR (botões maiores: 60dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="COMEÇAR\nCORRIDA"
                android:textColor="#00FF66"
                android:letterSpacing="0.1"
                android:lineSpacingExtra="-2dp"
                app:icon="@drawable/ic_play"
                app:iconTint="#00FF66"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:strokeColor="#00FF66"
                app:strokeWidth="1dp"
                app:backgroundTint="#00210E"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#00FF66"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="FINALIZAR\nCORRIDA"
                android:textColor="#FF2A55"
                android:letterSpacing="0.1"
                android:lineSpacingExtra="-2dp"
                app:icon="@drawable/ic_stop"
                app:iconTint="#FF2A55"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:strokeColor="#FF2A55"
                app:strokeWidth="1dp"
                app:backgroundTint="#24000B"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#FF2A55"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================== LABEL TERMINAL ============================== -->
    <LinearLayout
        android:id="@+id/terminalLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERMINAL"
            android:textColor="#A09DA5"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ============================== TERMINAL ============================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/terminalCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#0A0410"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/terminalLabelContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="120dp">

        <ScrollView
            android:id="@+id/scrollMonitor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/txtSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>