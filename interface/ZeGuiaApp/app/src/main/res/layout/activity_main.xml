<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0410"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="#130822"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZÉ-GUIA"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"
        android:fontFamily="@font/orbitron"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/containerToggles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="45dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#1A0D2A"
            app:cardCornerRadius="10dp"
            app:strokeColor="#2E1A47"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    app:srcCompat="@drawable/ic_led"
                    app:tint="#A066FF" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/LED"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:scaleX="0.6"
                    android:scaleY="0.6"
                    app:thumbTint="#A066FF"
                    app:trackTint="#2E1A47" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="45dp"
            android:layout_height="50dp"
            app:cardBackgroundColor="#1A0D2A"
            app:cardCornerRadius="10dp"
            app:strokeColor="#2E1A47"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    app:srcCompat="@drawable/ic_bluetooth"
                    app:tint="#A066FF" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:scaleX="0.6"
                    android:scaleY="0.6"
                    app:thumbTint="#A066FF"
                    app:trackTint="#2E1A47" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainStatusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#130822"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CRONÔMETRO"
                            android:textColor="#A09DA5"
                            android:textSize="9sp"
                            android:fontFamily="@font/orbitron"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="2dp" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/txtCronometro"

                        android:layout_width="match_parent"
                        android:layout_height="0dp"

                        android:layout_weight="1"
                        android:text="0:00:00"
                        android:textColor="#00FF66"
                        android:textSize="24sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp"
                        android:fontFeatureSettings="tnum"
                        />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2E1A47"
                    android:layout_marginVertical="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATERIA"
                        android:textColor="#A09DA5"
                        android:textSize="9sp"
                        android:fontFamily="@font/orbitron" />

                    <TextView
                        android:id="@+id/txtBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/orbitron" />

                    <LinearLayout
                        android:id="@+id/layoutBarrasBateria"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:weightSum="6">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00E5FF" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportar"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="16dp"
                        android:text="EXPORTAR"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/orbitron"
                        app:backgroundTint="#A066FF"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:background="#2E1A47" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/btnAbrirEdicao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PARÂMETROS"
                            android:textColor="#A09DA5"
                            android:textSize="9sp"
                            android:fontFamily="@font/orbitron"
                            android:layout_marginTop="2dp"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="2dp"
                            app:srcCompat="@android:drawable/ic_menu_edit"
                            app:tint="#A066FF"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kp"
                                android:textColor="#CFC9D8"
                                android:textSize="10sp"
                                android:fontFamily="@font/sourcecodepro_bold" />

                            <TextView
                                android:id="@+id/txtParamKp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/sourcecodepro_bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ki"
                                android:textColor="#CFC9D8"
                                android:textSize="10sp"
                                android:fontFamily="@font/sourcecodepro_bold" />

                            <TextView
                                android:id="@+id/txtParamKi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/sourcecodepro_bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kd"
                                android:textColor="#CFC9D8"
                                android:textSize="10sp"
                                android:fontFamily="@font/sourcecodepro_bold" />

                            <TextView
                                android:id="@+id/txtParamKd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/sourcecodepro_bold" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout> <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E1A47"
                android:layout_marginVertical="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMAÇÕES"
                        android:textColor="#A09DA5"
                        android:textSize="9sp"
                        android:fontFamily="@font/orbitron" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estado" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold" />
                        <TextView android:id="@+id/txtEstadoRobo" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/sourcecodepro_bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Modo" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold" />
                        <TextView android:id="@+id/txtModoRobo" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/sourcecodepro_bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estratégia" android:textColor="#CFC9D8" android:textSize="10sp" android:fontFamily="@font/sourcecodepro_bold" />
                        <TextView android:id="@+id/txtEstrategiaRobo" android:text="—" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/sourcecodepro_bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/labelControles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTROLES"
        android:textColor="#A09DA5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/orbitron"
        app:layout_constraintTop_toBottomOf="@id/mainStatusCard"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"/>

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/labelControles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="CALIBRAR"
                android:textColor="#F39200"
                app:icon="@drawable/ic_calibrar"
                app:iconTint="#F39200"
                app:strokeColor="#F39200"
                app:cornerRadius="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/orbitron" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLerSensores"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="SENSORES"
                android:textColor="#FFEB3B"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="#FFEB3B"
                app:strokeColor="#FFEB3B"
                app:cornerRadius="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/orbitron" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#0D0614"
            app:strokeColor="#2E1A47"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/modo"
                        app:tint="#00E5FF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODO"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/follower"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="SEGUIDOR"
                        android:textColor="#00BFFF"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chase"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="PERSEGUIDOR"
                        android:textColor="#00BFFF"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/ic_estrategia"
                        app:tint="#E020FF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTRATÉGIA"
                        android:textColor="#E020FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/conservative"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="CONSERVADOR"
                        android:textColor="#C040FF"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/risk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="ARRISCADO"
                        android:textColor="#C040FF"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="COMEÇAR\nCORRIDA"
                android:textColor="#00FF66"
                app:icon="@drawable/ic_play"
                app:iconTint="#00FF66"
                app:iconGravity="textStart"
                app:strokeColor="#00FF66"
                app:strokeWidth="1dp"
                app:backgroundTint="#00210E"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#00FF66"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="FINALIZAR\nCORRIDA"
                android:textColor="#FF2A55"
                app:icon="@drawable/ic_stop"
                app:iconTint="#FF2A55"
                app:iconGravity="textStart"
                app:strokeColor="#FF2A55"
                app:strokeWidth="1dp"
                app:backgroundTint="#24000B"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#FF2A55"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminalLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERMINAL"
            android:textColor="#A09DA5"
            android:textSize="12sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0A0410"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/terminalLabelContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/scrollMonitor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>