<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0410"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/topbar_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZÉ-GUIA"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"
        android:fontFamily="@font/orbitron"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_led"
                app:tint="#A066FF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LED"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:fontFamily="@font/orbitron"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/LED"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="24dp" />
            <TextView
                android:id="@+id/txtStatusLED"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESLIGADO"
                android:textColor="#3D285B"
                android:textSize="8sp"
                android:fontFamily="@font/orbitron"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#130822"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="11dp"
            android:paddingHorizontal="12dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="top">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_bluetooth"
                    app:tint="#A066FF"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BLUETOOTH"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtStatusBluetooth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="DESLIGADO"
                        android:textColor="#4D3475"
                        android:textSize="10sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>

            <View
                android:layout_width="1.5dp"
                android:layout_height="40dp"
                android:background="#2E1A47" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:gravity="top">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@android:drawable/ic_menu_recent_history"
                    app:tint="#A066FF"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRONÔMETRO"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtCronometro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="00:00.000"
                        android:textColor="#EBB3FF"
                        android:textSize="18sp"
                        android:fontFamily="@font/sourcecodepro_bold"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/infoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#0A0410"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMAÇÕES"
                        android:textColor="#A09DA5"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estado" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtEstadoRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parado" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Modo" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtModoRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estratégia" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtEstrategiaRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="0dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bateria" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtBateria" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0V" android:textColor="#00FF66" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#2E1A47" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:fontFamily="@font/orbitron"
                        android:text="PARÂMETROS"
                        android:textColor="#A09DA5"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbrirEdicao"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="0.4"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="EDITAR"
                        android:textColor="#EBB3FF"
                        android:textSize="8sp"
                        android:fontFamily="@font/orbitron"
                        app:strokeColor="#4D3475"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="V" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtParamV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kp" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtParamKp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ki" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtParamKi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="0dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kd" android:textColor="#CFC9D8" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                    <TextView android:id="@+id/txtParamKd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#EBB3FF" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/labelControles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTROLES"
        android:textColor="#A09DA5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/orbitron"
        app:layout_constraintTop_toBottomOf="@id/infoContainer"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"/>

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/labelControles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calibrate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="CALIBRAR"
            android:textColor="#F39200"
            app:icon="@drawable/ic_calibrar"
            app:iconTint="#F39200"
            app:iconGravity="textStart"
            app:strokeColor="#F39200"
            app:strokeWidth="1dp"
            app:backgroundTint="#1F1200"
            app:cornerRadius="12dp"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/orbitron"
            app:rippleColor="#F39200"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#0D0614"
            app:strokeColor="#2E1A47"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/modo"
                        app:tint="#00E5FF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODO"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/follower"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="SEGUIDOR"
                        android:textColor="#00BFFF"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chase"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="PERSEGUIDOR"
                        android:textColor="#00BFFF"
                        app:strokeColor="#00BFFF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#00111A"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#00BFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/ic_estrategia"
                        app:tint="#E020FF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTRATÉGIA"
                        android:textColor="#E020FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/conservative"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="CONSERVADOR"
                        android:textColor="#C040FF"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/risk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="ARRISCADO"
                        android:textColor="#C040FF"
                        app:strokeColor="#C040FF"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0C0411"
                        app:cornerRadius="12dp"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:fontFamily="@font/orbitron"
                        app:rippleColor="#C040FF"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="COMEÇAR\nCORRIDA"
                android:textColor="#00FF66"
                app:icon="@drawable/ic_play"
                app:iconTint="#00FF66"
                app:iconGravity="textStart"
                app:strokeColor="#00FF66"
                app:strokeWidth="1dp"
                app:backgroundTint="#00210E"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#00FF66"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="FINALIZAR\nCORRIDA"
                android:textColor="#FF2A55"
                app:icon="@drawable/ic_stop"
                app:iconTint="#FF2A55"
                app:iconGravity="textStart"
                app:strokeColor="#FF2A55"
                app:strokeWidth="1dp"
                app:backgroundTint="#24000B"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                app:rippleColor="#FF2A55"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminalLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERMINAL"
            android:textColor="#A09DA5"
            android:textSize="14sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0A0410"
        app:strokeColor="#2E1A47"
        app:strokeWidth="1dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/terminalLabelContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/scrollMonitor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="✓ Sistema inicializado..."/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>