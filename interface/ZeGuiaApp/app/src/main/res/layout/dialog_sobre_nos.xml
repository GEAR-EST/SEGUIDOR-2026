<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="#0D0618"
    app:cardCornerRadius="16dp"
    app:strokeColor="#2C164D"
    app:strokeWidth="1.5dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- Botão fechar -->
            <ImageView
                android:id="@+id/btnFecharModal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_close_button"
                android:padding="8dp"
                android:contentDescription="@string/desc_fechar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Logos: GEAR + UEA -->
            <LinearLayout
                android:id="@+id/layoutLogos"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/gear_logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gear_descricao"
                        android:textColor="#A09DA5"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:fontFamily="@font/sourcecodepro_bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#2C164D" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/logo_uea"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uea_descricao"
                        android:textColor="#A09DA5"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:fontFamily="@font/sourcecodepro_bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divisor horizontal -->
            <View
                android:id="@+id/topDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#231438"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layoutLogos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Luzes animadas -->
            <LinearLayout
                android:id="@+id/layoutLuzes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_inner_panel"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/topDivider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View android:id="@+id/luz1" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginHorizontal="3dp" android:background="@drawable/bg_luz_apagada" />
                <View android:id="@+id/luz2" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginHorizontal="3dp" android:background="@drawable/bg_luz_apagada" />
                <View android:id="@+id/luz3" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginHorizontal="3dp" android:background="@drawable/bg_luz_apagada" />
                <View android:id="@+id/luz4" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginHorizontal="3dp" android:background="@drawable/bg_luz_apagada" />
                <View android:id="@+id/luz5" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginHorizontal="3dp" android:background="@drawable/bg_luz_apagada" />
            </LinearLayout>

            <!-- Título + Subtítulo -->
            <LinearLayout
                android:id="@+id/layoutTitulos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/layoutLuzes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtTituloModal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_grid_largada"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/orbitron" />

                <TextView
                    android:id="@+id/txtSubtituloModal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitulo_criadores"
                    android:textColor="#A066FF"
                    android:textSize="15sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Label POSIÇÕES -->
            <LinearLayout
                android:id="@+id/sectionPosicoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/layoutTitulos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_posicoes"
                    android:textColor="#A09DA5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3A215C" />
            </LinearLayout>

            <!-- Cards de membros -->
            <LinearLayout
                android:id="@+id/layoutMembros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/sectionPosicoes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- P1 — esquerda -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="148dp" android:orientation="vertical" android:background="@drawable/bg_member_card" android:layout_marginTop="9dp" android:paddingStart="12dp" android:paddingEnd="18dp" android:paddingTop="5dp" android:paddingBottom="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/membro_celio" android:textColor="#E0AAFF" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargo_celio" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" android:letterSpacing="0.05" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/posicao_1" android:textColor="#00BFFF" android:textSize="11sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#0D0614" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="6dp" android:layout_marginTop="4dp" android:layout_gravity="top|start" />
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#4A2870" />
                    </LinearLayout>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                </LinearLayout>

                <!-- P2 — direita -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#4A2870" />
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_member_card" android:layout_marginTop="9dp" android:paddingStart="18dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/membro_fernanda" android:textColor="#E0AAFF" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cargo_fernanda" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" android:letterSpacing="0.05" android:gravity="end" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/posicao_2" android:textColor="#00BFFF" android:textSize="11sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#0D0614" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginEnd="6dp" android:layout_marginTop="4dp" android:layout_gravity="top|end" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- P3 — esquerda -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="148dp" android:orientation="vertical" android:background="@drawable/bg_member_card" android:layout_marginTop="9dp" android:paddingStart="12dp" android:paddingEnd="18dp" android:paddingTop="5dp" android:paddingBottom="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/membro_leandra" android:textColor="#E0AAFF" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargo_leandra" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" android:letterSpacing="0.05" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/posicao_3" android:textColor="#00BFFF" android:textSize="11sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#0D0614" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="6dp" android:layout_marginTop="4dp" android:layout_gravity="top|start" />
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#4A2870" />
                    </LinearLayout>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                </LinearLayout>

                <!-- P4 — direita -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#4A2870" />
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_member_card" android:layout_marginTop="9dp" android:paddingStart="18dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/membro_matheus" android:textColor="#E0AAFF" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cargo_matheus" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" android:letterSpacing="0.05" android:gravity="end" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/posicao_4" android:textColor="#00BFFF" android:textSize="11sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#0D0614" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginEnd="6dp" android:layout_marginTop="4dp" android:layout_gravity="top|end" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- P5 — esquerda -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="148dp" android:orientation="vertical" android:background="@drawable/bg_member_card" android:layout_marginTop="9dp" android:paddingStart="12dp" android:paddingEnd="18dp" android:paddingTop="5dp" android:paddingBottom="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/membro_luan" android:textColor="#E0AAFF" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/sourcecodepro_bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargo_luan" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="@font/sourcecodepro_bold" android:letterSpacing="0.05" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/posicao_5" android:textColor="#00BFFF" android:textSize="11sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#0D0614" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="6dp" android:layout_marginTop="4dp" android:layout_gravity="top|start" />
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#4A2870" />
                    </LinearLayout>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- Seção QR Code -->
            <LinearLayout
                android:id="@+id/sectionQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/layoutMembros"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_escaneie_qr"
                    android:textColor="#A09DA5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3A215C" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQrCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:strokeColor="#A066FF"
                app:strokeWidth="2dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/sectionQr"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:padding="6dp"
                    android:src="@drawable/qrcode_foto"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/desc_qr_code" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
