<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#130822"
    app:cardCornerRadius="16dp"
    app:strokeColor="#2C164D"
    app:strokeWidth="1.5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloExportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnFecharExportar"
            android:fontFamily="@font/orbitron"
            android:text="RESUMO DA CORRIDA"
            android:textColor="#EBB3FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFecharExportar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/txtTituloExportar"
            android:background="@drawable/bg_close_button"
            android:src="@drawable/ic_close"
            app:tint="#EBB3FF" />

        <View
            android:id="@+id/topDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/txtTituloExportar"
            android:layout_marginTop="20dp"
            android:background="#231438" />

        <LinearLayout
            android:id="@+id/layoutTopData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topDivider"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATA / HORA" android:textColor="#A09DA5" android:textSize="10sp" android:fontFamily="@font/orbitron" android:textStyle="bold"/>
                <TextView android:id="@+id/txtResumoData" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08/05/2026\n19:05" android:textColor="#A09DA5" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#231438"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPO FINAL" android:textColor="#A09DA5" android:textSize="10sp" android:fontFamily="@font/orbitron" android:textStyle="bold"/>
                <TextView android:id="@+id/txtResumoTempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="000.000" android:textColor="#00FF66" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#231438"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROBÔ" android:textColor="#A09DA5" android:textSize="10sp" android:fontFamily="@font/orbitron" android:textStyle="bold"/>
                <TextView android:id="@+id/txtResumoRobo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zé-Guia" android:textColor="#A09DA5" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutTopData"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron" android:text="CONFIGURAÇÕES" android:textColor="#A09DA5" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#3A215C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutConfigDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/sectionConfiguracoes"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Endereço MAC - ESP32" android:textColor="#A09DA5" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoMac" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="C0:49:EF:65:16:FE" android:textColor="#00FF66" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modo" android:textColor="#A09DA5" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoModo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Seguidor" android:textColor="#00FF66" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estratégia" android:textColor="#A09DA5" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoEstrategia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Conservador" android:textColor="#00FF66" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionPid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutConfigDetalhes"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron" android:text="PARÂMETROS PID" android:textColor="#A09DA5" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#3A215C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPidGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/sectionPid"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_sensor_card" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kp" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoKp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15.6" android:textColor="#00FF66" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_sensor_card" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ki" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoKi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.2" android:textColor="#00FF66" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_sensor_card" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kd" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoKd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.0" android:textColor="#00FF66" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_sensor_card" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vel. Máx" android:textColor="#A09DA5" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/txtResumoVelMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.5" android:textColor="#00FF66" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionConclusao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutPidGrid"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron" android:text="CONCLUSÃO" android:textColor="#A09DA5" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#3A215C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutConclusaoBotoes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/sectionConclusao"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusCompleta"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="monospace"
                android:text="COMPLETA"
                android:textColor="#A09DA5"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#2C164D"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusParcial"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:text="PARCIAL"
                android:textColor="#A09DA5"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#2C164D"
                app:strokeWidth="1.2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionObservacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutConclusaoBotoes"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron" android:text="OBSERVAÇÕES" android:textColor="#A09DA5" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#3A215C" />
        </LinearLayout>

        <EditText
            android:id="@+id/editObservacoes"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_below="@id/sectionObservacoes"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_sensor_card"
            android:gravity="top|start"
            android:hint="Digite suas observações sobre a corrida..."
            android:textColorHint="#433B54"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:inputType="textMultiLine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopiarResumo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/editObservacoes"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/orbitron"
            android:text="COPIAR PARA ÁREA DE TRANSFERÊNCIA"
            android:textColor="#EBB3FF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="#EBB3FF"
            app:strokeColor="#EBB3FF"
            app:strokeWidth="1.5dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>