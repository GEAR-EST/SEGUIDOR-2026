<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#130822"
    app:cardCornerRadius="20dp"
    app:strokeColor="#A066FF"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="CONFIGURAR ESP32"
                android:textColor="#A066FF"
                android:fontFamily="@font/orbitron"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/btnFecharModalEsp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#A09DA5" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E1A47"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECIONAR SALVA:"
            android:textColor="#A09DA5"
            android:textSize="12sp"
            android:fontFamily="@font/orbitron"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerMacs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#A066FF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OU CADASTRAR NOVA:"
            android:textColor="#A09DA5"
            android:textSize="12sp"
            android:fontFamily="@font/orbitron"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editNovoMac"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ex: C0:49:EF:65:16:FE"
            android:textColorHint="#4D4D4D"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="textVisiblePassword"
            android:digits="0123456789ABCDEFabcdef:-"
            android:maxLength="17"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="#2E1A47"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarEsp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="APLICAR"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/orbitron"
            app:backgroundTint="#A066FF"
            app:cornerRadius="10dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>