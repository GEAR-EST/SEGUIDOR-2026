<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#150B24"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/btnFechar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Editar"
            android:src="@drawable/ic_edit_pencil"
            app:tint="#EBB3FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcecodepro_bold"
            android:text="EDITAR\nPARÂMETROS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.9" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFechar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintTop_toTopOf="@+id/layoutHeader"
        android:background="@drawable/bg_close_button"
        android:contentDescription="Fechar"
        android:src="@drawable/ic_close"
        app:tint="#EBB3FF" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/layoutHeader"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="#261A3A" />

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sourcecodepro_bold"
                android:text="Velocidade Máxima (VM)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/btnDiminuirV"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editV"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="7.0"
                    android:textColor="#00FF66"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAumentarV"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sourcecodepro_bold"
                android:text="Constante de Proporcionalidade (Kp)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/btnDiminuirKp"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editKp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="1.7"
                    android:textColor="#00FF66"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAumentarKp"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sourcecodepro_bold"
                android:text="Constante de Integral (Ki)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/btnDiminuirKi"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editKi"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="1.8"
                    android:textColor="#00FF66"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAumentarKi"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sourcecodepro_bold"
                android:text="Constante de Derivação (Kd)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/btnDiminuirKd"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editKd"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="2.5"
                    android:textColor="#00FF66"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAumentarKd"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sourcecodepro_bold"
                android:text="Contador de Marcas"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/btnDiminuirMarcas"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editMarcas"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/sourcecodepro_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="11"
                    android:textColor="#00FF66"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAumentarMarcas"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A066FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutContent"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/sourcecodepro_bold"
            android:text="CANCELAR"
            android:textColor="#EBB3FF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#522C6D"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:fontFamily="@font/sourcecodepro_bold"
            android:text="SALVAR"
            android:textColor="#EBB3FF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#3E1D54"
            app:cornerRadius="12dp"
            app:strokeColor="#522C6D"
            app:strokeWidth="2dp" />
    </LinearLayout>

</RelativeLayout>